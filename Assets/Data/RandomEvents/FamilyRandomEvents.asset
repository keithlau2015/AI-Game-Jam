  m_Script: {fileID: 11500000, guid: 6cad5e0f69e266947af27c5f01867153, type: 3}
  m_Name: Event_Family_03
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.Model.RandomEventDefinition
  title: 繼承生意或追夢
  viewpointCharacter: 爸爸
  description: 我希望兒子接手店鋪，但他有自己的夢想，我不知該支持還是堅持。
  weight: 1
  canRepeat: 0
  options:
  - label: 我支持他追夢
    outcomeText: 我拍著兒子的肩說「去吧」，他眼眶紅了，但我轉身時嘆了口氣。
    effectType: 14
    value: 10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: 10
    tertiaryEffectType: 16
    tertiaryValue: -10
  - label: 我要求他先試一年
    outcomeText: 我要求他試一年，他勉強答應，但眼神裡沒有光。
    effectType: 16
    value: 10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: -10
    tertiaryEffectType: 14
    tertiaryValue: -10
  - label: 兒子提出折中方案
    outcomeText: 他說邊做邊學，全家都鬆口氣，但我看得出他壓力很大。
    effectType: 16
    value: 10
    duration: 0
    secondaryEffectType: 14
    secondaryValue: 10
    tertiaryEffectType: 15
    tertiaryValue: -10
