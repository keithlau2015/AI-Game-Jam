  m_Script: {fileID: 11500000, guid: 6cad5e0f69e266947af27c5f01867153, type: 3}
  m_Name: Event_Family_01
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.Model.RandomEventDefinition
  title: 弟弟哭泣考試在即
  viewpointCharacter: 弟弟
  description: 我坐在地上哭，哥哥明天要考試，爸媽都在忙，我好想要人陪。
  weight: 1
  canRepeat: 0
  options:
  - label: 要爸爸來哄我
    outcomeText: 爸爸放下工作抱起我，我破涕為笑，但他半夜還在加班。
    effectType: 16
    value: 10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: 10
    tertiaryEffectType: 14
    tertiaryValue: -10
  - label: 媽媽來哄我
    outcomeText: 媽媽溫柔拍拍我，我不哭了，但她累得腰都直不起來。
    effectType: 16
    value: 10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: -10
    tertiaryEffectType: 0
    tertiaryValue: 0
  - label: 哥哥戴耳機不理我
    outcomeText: 哥哥繼續讀書，我哭更大聲，全家氣氛變得好緊繃。
    effectType: 16
    value: -10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: -10
    tertiaryEffectType: 14
    tertiaryValue: 10
--- !u!114 &11400002
