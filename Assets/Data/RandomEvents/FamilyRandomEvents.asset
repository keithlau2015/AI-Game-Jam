  m_Script: {fileID: 11500000, guid: 6cad5e0f69e266947af27c5f01867153, type: 3}
  m_Name: Event_Family_14
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.Model.RandomEventDefinition
  title: 考研失敗
  viewpointCharacter: 媽媽
  description: 孩子考研失利，垂頭喪氣，我好心疼。
  weight: 1
  canRepeat: 0
  options:
  - label: 我做美食安慰他
    outcomeText: 我做了一桌他愛吃的，他勉強笑了笑，但還是心事重重。
    effectType: 16
    value: 10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: 10
    tertiaryEffectType: 14
    tertiaryValue: -10
  - label: 我幫他找調劑學校
    outcomeText: 我四處打聽調劑資訊，他不太願意，但還是配合著填了資料。
    effectType: 14
    value: 10
    duration: 0
    secondaryEffectType: 15
    secondaryValue: -10
    tertiaryEffectType: 0
    tertiaryValue: 0
  - label: 我建議他先休息
    outcomeText: 我說「先休息一陣子」，他鬆了口氣，但我知道他心裡還是不甘。
    effectType: 15
    value: 10
    duration: 0
    secondaryEffectType: 16
    secondaryValue: -10
    tertiaryEffectType: 0
    tertiaryValue: 0
